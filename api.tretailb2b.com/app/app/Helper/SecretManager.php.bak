<?php
namespace App\Helper;

use Google\Cloud\SecretManager\V1\SecretManagerServiceClient;

class SecretManager {
    //
    public static function getSecret() {
       
        if(app()->isProduction()){
            // putenv('GOOGLE_APPLICATION_CREDENTIALS=./tretailb2b-bc7bdb32f362.json');
            $config = ['credentials' => public_path()."/tretailb2b-bc7bdb32f362.json"];

            $projectId = 'tretailb2b-fuzonmedia'; //your project name

            // Create the Secret Manager client
            $client = new SecretManagerServiceClient($config);

            // $client->useApplicationDefaultCredentials();

            // Access a secret by its name
            $kafka = $client->accessSecretVersion('projects/tretailb2b-fuzonmedia/secrets/kafka/versions/1')->getPayload()->getData();
            putenv("KAFKA_BROKER=$kafka");
            $mysql_db = $client->accessSecretVersion('projects/tretailb2b-fuzonmedia/secrets/mysql-db/versions/1')->getPayload()->getData();
            putenv("DB_HOST=$mysql_db");
            $quartzapi = $client->accessSecretVersion('projects/tretailb2b-fuzonmedia/secrets/quartz-api/versions/1')->getPayload()->getData();
            putenv("AUTOMATE_JOB_HOST=$quartzapi:8085");

            // Decode the secret as a string
            // $secret = base64_decode($secret);
        }
    }
}