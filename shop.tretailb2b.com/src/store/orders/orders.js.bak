const styles = {
  image: { maxHeight: '3rem' }
}

function createData(thumbnail_image, sku,quantity) {
  return { thumbnail_image ,sku ,quantity };
}

const ComboPanel=({ id, record, resource })=>{
  const classes = useTableStyles();
  let rows=[];
  if(record.combo_items.length==0 ) return null;
  rows=record.combo_items.map((val)=>createData(val.thumbnail_image,val.item_sku_product, val.quantity));
  return (
    <TableContainer component={Paper}>
      <Table className={classes.table} aria-label="simple table">
        <TableHead>
          <TableRow>
            <TableCell>Product Image</TableCell>
            <TableCell align="right">SKU</TableCell>
            <TableCell align="right">Quantity</TableCell>
          </TableRow>
        </TableHead>
        <TableBody>
          {rows.map((row) => (
            <TableRow key={row.item_id}>
              <TableCell><Avatar alt="picture" src={row.thumbnail_image} /></TableCell>
              <TableCell align="right">{row.sku}</TableCell>
              <TableCell align="right">{row.quantity}</TableCell>
            </TableRow>
          ))}
        </TableBody>
      </Table>
    </TableContainer>
  );
}

const ItemField = ({classes,record={},...rest}) => {
  return (
    <ArrayField source="lineitems" label="Items" record={record} {...rest}>
      <Datagrid expand={<ComboPanel/>} isRowExpandable={false}>
        {/* <ImageField classes={classes} source="thumbnail_image" label="Product Image" record={record} {...rest}/> */}
        <ChipField source="item_sku_product" label="SKU" record={record} {...rest}/>
        <ChipField source="quantity" label="Quantity" record={record} {...rest}/>
      </Datagrid>
    </ArrayField>
  );
}

const ShippingField = ({classes,record={},...rest}) => {
  return (
    <ArrayField source="" label="Shipping Details" record={record} {...rest}>
      <Datagrid expand={<ComboPanel/>} isRowExpandable={false}>
        {/* <ImageField classes={classes} source="thumbnail_image" label="Product Image" record={record} {...rest}/> */}
        <FunctionField render={record => `${record.shipping_from_city}, ${record.shipping_from_state_code}, ${record.shipping_from_pin_code}`} label="From" record={record} {...rest}/>
        <FunctionField render={record => `${record.shipping_to_city}, ${record.shipping_to_state_code}, ${record.shipping_to_pin_code}`} label="To" record={record} {...rest}/>
      </Datagrid>
    </ArrayField>
  );
}

export const OrderList = ({ classes, permissions, ...props }) => {
  const [orders,setOrders] = useState([]);
  const [sort, setSort] =  useState({ field: 'id', order: 'DESC' });
  const [currentPage, setCurrentPage] = useState(1);
  const dataProvider = useDataProvider();
  const [total, setTotal] = useState(0);
  const redirect = useRedirect();
  const [loading, setLoading] = useState();
  const [searchText, setSearchText] = useState(null);
  const [searchTextPage, setSearchTextPage] = useState(1);
  const orderClick = (id) => {}

  React.useEffect(() => {
    setLoading(true)
    const params = {
      pagination: {
        page:currentPage,
        perPage: 10
      },
      sort: {
        field:'id',
        order: 'desc'
      },
      filter:{q:searchText}
    }
    dataProvider.getList(`orders`, params)
    .then(({data,total}) => {
      setOrders(data);
      setTotal( Math.ceil(parseInt(total) / parseInt(10)) );
      setLoading(false);
    })
    .catch((e)=>{
      setLoading(false);
      throw (e.message || e);
    })
  },[currentPage])


  React.useEffect(() => {
    setLoading(true)
    const params= {
      pagination:{
        page:1,
        perPage: 10
      },
      sort: {
        field:'id',
        order: 'desc'
      },
      filter:{q:searchText}
    }
    dataProvider.getList(`orders`, params)
    .then(({data,total}) => {
      setOrders(data);
      setTotal( Math.ceil(parseInt(total) / parseInt(10)) );
      setLoading(false);
    })
    .catch((e) => {
      setLoading(false);
      throw (e.message || e);
    })
  },[searchTextPage, searchText])
  return (
    <>
      <Box p={2}>
        <MaterialTextField
          variant="filled"
          InputProps={{
            startAdornment: (
              <InputAdornment position="center">
                <SearchIcon />
              </InputAdornment>
            ),
          }}
          onChange = { (e) => setSearchText(e.target.value) }
        />
        <Button variant="text" color="primary" startIcon={<AddIcon />} style={{marginLeft:'490px'}}  onClick={() =>redirect(`orders/create`)}>
          Create 
        </Button>
      </Box>
      {
        loading
        ?<Loading/>
        :<Datagrid 
          rowClick={(id) => redirect(`/orders/${id}`)}
          data={keyby(orders,'id')}
          ids={orders.map(({ id }) => id)}
          currentSort={sort}
        >
          <TextField source="order_ref" label="Order Ref"/>
          <DateField source="order_date" label="Order Date"/>
          <ChipField source="sum_total" label="Order Amount" />
          <ItemField/>
          <TextField source="priority" label="Is Priority"/>
          <DateField source="dispatch_by" label="Dispatch By"/>
          <TextField source="status" label="Status"/>
          <TextField source="marketplace_identifier" label="MarketPlace Identifier"/>
          <TextField source="marketplace_name"  label="Marketplace name" />
          <ShippingField/>
          <DateField source="updated_at" label="Last Updated"/>
        </Datagrid>
      }
      <CustomPagination count={total} currentPage={currentPage} onChange={( page ) => setCurrentPage( page ) } />
    </>
  );
}

const OrderOperation = ( props ) => {
  const classes = useSelectStyles();
  const [actionName, setActionName] = useState("ORDER_UPLOAD");
  const [uploadFile, setUploadFile] = useState(null);
  const [loading, setLoading] = useState( false );
  const notify = useNotify();
  const [showDateInput,setShowDateInput] = useState({ start_date: '', end_date: '' });
  const redirect = useRedirect();
  const handleSubmit = () => {
    const allowedTypes = ['csv'];
    if( uploadFile != null && uploadFile.size && uploadFile.size !== 0) {
      const tmp_arr = uploadFile.name.split(".");
      const ext = tmp_arr[tmp_arr.length - 1];
      if( allowedTypes.indexOf(ext) !== -1) {
        setLoading(false);
        const formData = new FormData();
        formData.append('type', actionName);
        formData.append('file', uploadFile);
        // formData.append('data',showDateInput);
        fetch(process.env.REACT_APP_API_ENDPOINT+'/logs', { 
          method: 'POST', 
          body: formData,
          credentials: 'include'
        })
        .then(res => res.json())
        .then(json => {
          setLoading(false);
          if(json.status == "success") {
            notify(`${json.message}`, 'success');
            redirect('/logtab');
          } else {
            notify(`${json.message}`, 'warning');
          }
        })
        .catch(error => {
          setLoading(false);
          notify(`${error.message}`, 'warning');
        });
      } else {
        notify('File is not valid','warning');
      }
    } else {
      notify('Inputs is not valid','warning');
    }
  }
  if (loading) return <Loading />;
  return (
    <Card>
      <CardContent>
        <Grid container>
          <Grid xs={12}>
            <FormControl variant="filled" className={classes.formControl}>
              <InputLabel id="demo-simple-select-filled-label">Action</InputLabel>
              <Select
                labelId="demo-simple-select-label"
                id="demo-simple-select"
                value={actionName}
                onChange={(e)=> setActionName( e.target.value )}
              >
                <MenuItem value={"ORDER_UPLOAD"}> New Order Upload </MenuItem>
              </Select>
            </FormControl>
          </Grid>
          <Grid xs={12}>
            <FormControl variant="filled" className={classes.formControl}>
              <input type="file" name="file" className="file" onChange={(e) => setUploadFile(e.target.files[0])}/>
            </FormControl>
          </Grid>
          <Grid> 
            <Paper elevation={0} style={{padding:'10px'}}>
              <Typography >
                Download the CSV template below.To download click on DOWNLOAD button. Fill the CSV file with valid data and upload it. order ref and invoice number,order date,customer phone,customer phone,customer email,customer pincode,customer state,ship to name,ship to address,ship to state,ship to phone no,item sku,sale price,qty,lineitem total discount amount,sales channel,total shipping cost,order type,dispatch by columns should be present in the CSV file.
                <br/>
                <a href="https://storage.googleapis.com/public-templates/new_order_template.csv">Download</a>
                <br/>
                Upload Order with CSV file and upload it into the system.To upload CSV file please click on the CREATE button.
              </Typography>
            </Paper>
          </Grid>
        </Grid>
      </CardContent>
      <CardActions>
        <Button variant="contained" color="primary"  onClick={() => handleSubmit()}>Create</Button>
      </CardActions>
    </Card>
  );
}

TabPanel.propTypes = {
  children: PropTypes.node,
  index: PropTypes.any.isRequired,
  value: PropTypes.any.isRequired
};

function a11yProps(index) {
  return {
    id: `scrollable-tab-${index}`,
    'aria-controls': `scrollable-tabpanel-${index}`,
  };
}

function TabPanel(props) {
  const { children, value, index, ...other } = props;
  const classes = usePanelStyles();
  return (
    <div
      role="tabpanel"
      hidden={value !== index}
      id={`scrollable-auto-tabpanel-${index}`}
      aria-labelledby={`scrollable-auto-tab-${index}`}
      {...other}
    >
      {value === index && (
        <Box>
          <Paper className={classes.paper}>{children}</Paper> 
        </Box>
      )}
    </div>
  );
}

export const OrderTabs = ( props ) =>  {
  const [panel,setPanel]=useState(0);
  const handleChange=(event,newValue)=>{
    setPanel(newValue);
  }
  return (
    <div>
      <Paper elevation={2}> 
        <Tabs value={panel} onChange={handleChange} aria-label="simple tabs example">
          <Tab label="Orders"   {...a11yProps(0)} />
          <Tab label="Operation" {...a11yProps(1)} />
        </Tabs>
      </Paper>
      <TabPanel value={panel} index={0}> <OrderList {...props} /> </TabPanel>
      <TabPanel value={panel} index={1}> <OrderOperation {...props}/> </TabPanel>
    </div>
  );
} 