const ReturnOperation = ( props ) => {

    const classes = useSelectStyles();
    const [actionName, setActionName] = useState("RETURN_UPLOAD");
    const [uploadFile, setUploadFile] = useState(null);
    const [loading, setLoading] = useState( false );
    const notify = useNotify();
    const redirect = useRedirect();
  
    

    const handleSubmit = () => {
       const allowedTypes = ['csv'];
       
       if( uploadFile != null && 
           uploadFile.size &&
           uploadFile.size !== 0
           
        ){
           const tmp_arr = uploadFile.name.split(".");
           const ext = tmp_arr[tmp_arr.length - 1];
           if( allowedTypes.indexOf(ext) !== -1){
                setLoading(false);
                const formData = new FormData();
                formData.append('type', actionName);
                formData.append('file', uploadFile);
                // formData.append('data',showDateInput);
                fetch(process.env.REACT_APP_API_ENDPOINT+'/logs', { 
                  method: 'POST',
                  body: formData,
                  credentials: 'include'
                })
                .then(res => res.json())
                .then(json => {
                  setLoading(false);
                  if(json.status == "success") {
                    notify(`${json.message}`, 'success');
                    redirect('/logtab');
                  }
                  else {
                    notify(`${json.message}`, 'warning');
                  }
                })
                .catch(error => {
                   setLoading(false);
                   notify(`${error.message}`, 'warning');
                });
           }else{
              notify('File is not valid','warning');
           }
        }else{
           notify('Inputs is not valid','warning');
        }
    }
  
    if (loading) return <Loading />;
  
    return (
       <Card>
           <CardContent>
            <Grid container>
              <Grid xs={12}>
                <FormControl variant="filled" className={classes.formControl}>
                <InputLabel id="demo-simple-select-filled-label">Action</InputLabel>
                <Select
                  labelId="demo-simple-select-label"
                  id="demo-simple-select"
                  value={actionName}
                  onChange={(e)=> setActionName( e.target.value )}
                >
                  <MenuItem value={"RETURN_UPLOAD"}> SALES RETURN UPLOAD </MenuItem>
                </Select>
                </FormControl>
              </Grid>
              <Grid xs={12}>
                 <FormControl variant="filled" className={classes.formControl}>
                   <input type="file" name="file" className="file" onChange={(e) => setUploadFile(e.target.files[0])}/>
                 </FormControl>
              </Grid>
              <Grid> 
                  <Paper elevation={0} style={{padding:'10px'}}>
                     <Typography >
                       Download the CSV template below.To download click on DOWNLOAD button. Fill the CSV file with valid data and upload it. order ref,SQU,line item id (if any),condition (0-bad 1- good),quantity ,description, received date by columns should be present in the CSV file.
                       <br/>
                       <a href="https://storage.googleapis.com/public-templates/return_receieve.csv">Download</a>
                       <br/>
                       Upload  Return Order with CSV file and upload it into the system.To upload CSV file please click on the CREATE button.
                     </Typography>
                  </Paper>
              </Grid>
           </Grid>
  
           </CardContent>
           <CardActions>
              <Button variant="contained" color="primary" onClick={() => handleSubmit()}>Create</Button>
           </CardActions>
       </Card>
    );
  
  
  }

